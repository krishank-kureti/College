WER (AC_POWER excluded):\\n\")\nprint(round(corr_sorted, 3))\n\ncorr_melt <- melt(corr_matrix)\n\nggplot(corr_melt, aes(Var1, Var2, fill = value)) +\n  geom_tile(color = \"white\") +\n  scale_fill_gradient2(low  = muted(\"blue\"),\n                       mid  = \"white\",\n                       high = muted(\"red\"),\n                       midpoint = 0,\n                       limits   = c(-1, 1)) +\n  coord_equal() +\n  geom_text(aes(label = sprintf(\"%.2f\", value)), size = 3) +\n  theme_minimal() +\n  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +\n  labs(title = \"Correlation Matrix\",\n       x = NULL, y = NULL, fill = \"r\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-15T15:41:15.255592Z","iopub.execute_input":"2025-09-15T15:41:15.257300Z","iopub.status.idle":"2025-09-15T15:41:15.921769Z","shell.execute_reply":"2025-09-15T15:41:15.918969Z"}},"outputs":[{"name":"stdout","text":"\nCorrelation with DC_POWER (AC_POWER excluded):\n        IRRADIATION AMBIENT_TEMPERATURE  MODULE_TEMPERATURE         DAILY_YIELD \n              0.499               0.490               0.334               0.036 \n        TOTAL_YIELD \n              0.004 \n","output_type":"stream"},{"output_type":"display_data","data":{"image/png":"iVBORw0KGgoAAAANSUhEUgAAA0gAAANICAIAAAByhViMAAAABmJLR0QA/wD/AP+gvaeTAAAg\nAElEQVR4nOzdd1wT9/8H8PdlQiDsqYDiALWKita9tdZRR12tte6tWLe4xT3r3ts6cK9+655V\nnLirKFoHIgoiKxBC1v3+CCIjCVGBpPd7PR/+Ye7ed3l/LnB55e5yMCzLEgAAAAD89/HM3QAA\nAAAAFAwEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAA\nAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA\n4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACO\nQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgE\nOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLAD\nAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAA\nAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAACOQLADAAAA4AgEOwAAAAC